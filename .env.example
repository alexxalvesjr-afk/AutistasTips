# ─── Banco de dados ──────────────────────────────────────────────
# Conexão PostgreSQL (obrigatória)
DATABASE_URL="postgresql://autistastips:autistastips@localhost:5432/autistastips?schema=public"

# ─── Autenticação ────────────────────────────────────────────────
# Segredos JWT: gere com `openssl rand -base64 48` (mínimo 32 chars)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Duração dos tokens
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="7"

# ─── Aplicação ───────────────────────────────────────────────────
# URL pública da aplicação (usada para CORS/CSRF e links de e-mail)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── E-mail (recuperação de senha) ───────────────────────────────
# Em desenvolvimento, sem SMTP configurado, os links são logados no console
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AutistasTips <no-reply@localhost>"
